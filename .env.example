# ==========================================
# NexBiz - Environment Variables Template
# Copy this file to .env in backend/ and frontend/
# and configure values accordingly.
# ==========================================

# --- BACKEND EXPRESS SERVICE CONFIGURATION ---
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# --- MYSQL DATABASE CONFIGURATION ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_secure_password
DB_NAME=nexbiz_db

# --- RAZORPAY PAYMENT GATEWAY ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- AI MODULE SERVICE ---
AI_SERVICE_URL=http://127.0.0.1:8000

# --- FRONTEND VITE CONFIGURATION (Copy to frontend/.env) ---
VITE_API_URL=http://127.0.0.1:5000/api/v1

# --- FLASK AI SERVICE CONFIGURATION (Copy to ai-service/.env) ---
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=8000
NODE_BACKEND_URL=http://127.0.0.1:5000/api/v1
