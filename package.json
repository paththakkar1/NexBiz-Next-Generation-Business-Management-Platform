{
  "name": "nexbiz-monorepo",
  "version": "1.0.0",
  "description": "NexBiz - Next-Generation Business Management Platform for Indian SaaS",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "init-db": "npm --prefix server run init-db",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "saas",
    "erp",
    "crm",
    "business-management",
    "express",
    "react",
    "vite",
    "mysql",
    "tailwind"
  ],
  "author": "NexBiz Engineering Team",
  "license": "ISC"
}
